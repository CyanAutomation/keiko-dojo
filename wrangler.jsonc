{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keiko-dojo-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "local",
    "SCHEDULED_BACKUPS_ENABLED": "true",
    "AUTH_JWKS_URL": "http://localhost:9002/api/auth/jwks",
    "AUTH_ISSUER": "http://localhost:9002",
    "AUTH_AUDIENCE": "keiko-dojo-api",
    "GITHUB_APP_ID": "replace-with-github-app-id",
    "GITHUB_APP_INSTALL_URL": "https://github.com/apps/replace-keiko-dojo/installations/new",
    "MATMETRICS_FRONTEND_URL": "http://localhost:9002"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keiko-dojo-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SESSION_READ_LIMITER", "namespace_id": "119001", "simple": { "limit": 300, "period": 60 } },
    { "name": "SESSION_WRITE_LIMITER", "namespace_id": "119002", "simple": { "limit": 120, "period": 60 } },
    { "name": "BACKUP_WRITE_LIMITER", "namespace_id": "119003", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "queues": {
    "producers": [{ "binding": "BACKUP_QUEUE", "queue": "keiko-dojo-backups-local" }],
    "consumers": [{
      "queue": "keiko-dojo-backups-local",
      "max_batch_size": 10,
      "max_retries": 5,
      "dead_letter_queue": "keiko-dojo-backups-local-dlq"
    }]
  },
  "triggers": { "crons": ["0 2 * * *"] },
  "env": {
    "staging": {
      "name": "keiko-dojo-staging",
      "queues": {
        "producers": [{ "binding": "BACKUP_QUEUE", "queue": "keiko-dojo-backups-staging" }],
        "consumers": [{
          "queue": "keiko-dojo-backups-staging",
          "max_batch_size": 10,
          "max_retries": 5,
          "dead_letter_queue": "keiko-dojo-backups-staging-dlq"
        }]
      },
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "SCHEDULED_BACKUPS_ENABLED": "false",
        "AUTH_JWKS_URL": "https://matmetrics-teal.vercel.app/api/auth/jwks",
        "AUTH_ISSUER": "https://matmetrics-teal.vercel.app",
        "AUTH_AUDIENCE": "keiko-dojo-api",
        "GITHUB_APP_ID": "5456778",
        "GITHUB_APP_INSTALL_URL": "https://github.com/apps/keiko-dojo-staging/installations/new",
        "MATMETRICS_FRONTEND_URL": "https://matmetrics-teal.vercel.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "keiko-dojo-staging",
          "database_id": "7002a569-f450-4050-bb2a-b4cba208bf59",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "SESSION_READ_LIMITER", "namespace_id": "119101", "simple": { "limit": 300, "period": 60 } },
        { "name": "SESSION_WRITE_LIMITER", "namespace_id": "119102", "simple": { "limit": 120, "period": 60 } },
        { "name": "BACKUP_WRITE_LIMITER", "namespace_id": "119103", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "production": {
      "name": "keiko-dojo",
      "queues": {
        "producers": [{ "binding": "BACKUP_QUEUE", "queue": "keiko-dojo-backups" }],
        "consumers": [{
          "queue": "keiko-dojo-backups",
          "max_batch_size": 10,
          "max_retries": 5,
          "dead_letter_queue": "keiko-dojo-backups-dlq"
        }]
      },
      "triggers": { "crons": ["0 2 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "SCHEDULED_BACKUPS_ENABLED": "true",
        "AUTH_JWKS_URL": "https://matmetrics-teal.vercel.app/api/auth/jwks",
        "AUTH_ISSUER": "https://matmetrics-teal.vercel.app",
        "AUTH_AUDIENCE": "keiko-dojo-api",
        "GITHUB_APP_ID": "5469547",
        "GITHUB_APP_INSTALL_URL": "https://github.com/apps/keiko-dojo-production/installations/new",
        "MATMETRICS_FRONTEND_URL": "https://matmetrics-teal.vercel.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "keiko-dojo",
          "database_id": "750315f8-ef51-4d6e-86ea-41b076ec9de8",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "SESSION_READ_LIMITER", "namespace_id": "119201", "simple": { "limit": 300, "period": 60 } },
        { "name": "SESSION_WRITE_LIMITER", "namespace_id": "119202", "simple": { "limit": 120, "period": 60 } },
        { "name": "BACKUP_WRITE_LIMITER", "namespace_id": "119203", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
