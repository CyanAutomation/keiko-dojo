{
  "name": "keiko-dojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "migrate:local": "wrangler d1 migrations apply keiko-dojo-local --local",
    "migrate:production": "wrangler d1 migrations apply keiko-dojo --remote --env production",
    "backup:rehearse": "bash scripts/rehearse-d1-recovery.sh",
    "check:migrations": "wrangler d1 migrations apply keiko-dojo-local --local --persist-to .wrangler/migrations-check && wrangler d1 migrations list keiko-dojo-local --local --persist-to .wrangler/migrations-check"
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/node": "^26.6.5",
    "fallow": "3.34.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  }
}
