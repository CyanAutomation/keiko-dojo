{
  "name": "keiko-dojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test:release-preflight": "node --test scripts/production-preflight.test.mjs",
    "test:cloudflare-credential-preflight": "node --test scripts/cloudflare-credential-preflight.test.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "preflight:cloudflare-credentials": "node scripts/cloudflare-credential-preflight.mjs",
    "verify:migrations:production": "node scripts/production-preflight.mjs --verify-migrations",
    "verify:deployment:production": "node scripts/production-preflight.mjs --verify-migrations --verify-deployment",
    "test": "vitest run",
    "contract:lint": "redocly lint --extends minimal openapi.yaml",
    "contract:generate": "npm exec --yes --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 -- openapi-typescript openapi.yaml --output contracts/keiko-api.generated.ts",
    "contract:check": "npm run contract:lint && npm run contract:generate && git diff --exit-code -- contracts/keiko-api.generated.ts",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "security:dependencies:all": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "migrate:local": "wrangler d1 migrations apply keiko-dojo-local --local",
    "migrate:production": "wrangler d1 migrations apply keiko-dojo --remote --env production",
    "check:migrations": "wrangler d1 migrations apply keiko-dojo-local --local --persist-to .wrangler/migrations-check && wrangler d1 migrations list keiko-dojo-local --local --persist-to .wrangler/migrations-check"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@redocly/cli": "2.79.0",
    "@types/node": "^26.6.6",
    "fallow": "3.42.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.165.0"
  }
}
